{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"plugin": {
			"const": "QC"
		},
		"filename": {
			"const": "quickcheck.json"
		},
		"params": {
			"type": "object",
			"properties": {
				"config": {
					"type": "object",
					"properties": {
						"timeout": {
							"type": "integer",
							"description": "The timeout in milliseconds"
						}
					},
					"required": [
						"timeout"
					],
					"additionalProperties": false
				},
				"strategies": {
					"type": "array",
					"description": "Parameter options for each strategy",
					"oneOf": [
						{}
					]
				}
			},
			"additionalProperties": false
		}
	},
	"required": [
		"plugin",
		"filename",
		"params"
	]
}